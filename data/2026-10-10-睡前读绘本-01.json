  "dialogue": [
    {
      "role": "parent",
      "english": "Which books do you want to read tonight?",
      "ipa": "/wɪtʃ bʊks duː juː wɑnt tə riːd təˈnaɪt/",
      "chinese": "今晚想看哪几本书呀？"
    },
    {
      "role": "action",
      "text": "孩子从书架上选了五本，拿过来或指给大人看。"
    },
    {
      "role": "child",
      "english": "I want these.",
      "ipa": "/aɪ wɑnt ðiːz/",
      "chinese": "我想看这些。"
    },
    {
      "role": "parent",
      "english": "You picked five books!",
      "ipa": "/juː pɪkt faɪv bʊks/",
      "chinese": "你选了五本呀！"
    },
    {
      "role": "parent",
      "english": "Which one should we read first?",
      "ipa": "/wɪtʃ wʌn ʃʊd wiː riːd fɝst/",
      "chinese": "我们先读哪一本？"
    },
    {
      "role": "child",
      "english": "This one, please.",
      "ipa": "/ðɪs wʌn pliːz/",
      "chinese": "先读这本吧。",
      "target": true,
      "cue": "孩子指向一本时，替孩子示范这句，愿意就轻邀跟一次；只指书或用中文说也可以。"
    },
    {
      "role": "parent",
      "english": "This book looks fun.",
      "ipa": "/ðɪs bʊk lʊks fʌn/",
      "chinese": "这本书看起来很有趣。"
    },
    {
      "role": "action",
      "text": "一起坐舒服，打开孩子选的第一本，按绘本内容往下读。读到需要翻页时："
    },
    {
      "role": "parent",
      "english": "Turn the page.",
      "ipa": "/tɝn ðə peɪdʒ/",
      "chinese": "翻一页吧。"
    },
    {
      "role": "child",
      "english": "I'll do it!",
      "ipa": "/aɪl duː ɪt/",
      "chinese": "我来！"
    },
    {
      "role": "action",
      "text": "让孩子翻页，接着读。第一本读完，孩子还想继续时："
    },
    {
      "role": "parent",
      "english": "Which one is next?",
      "ipa": "/wɪtʃ wʌn ɪz nɛkst/",
      "chinese": "接下来读哪一本？"
    },
    {
      "role": "child",
      "english": "This one!",
      "ipa": "/ðɪs wʌn/",
      "chinese": "这本！"
    },
    {
      "role": "action",
      "text": "把下一本拿过来，继续读。后面也可以这样接；选了五本不代表一定要全部读完，困了就收尾。"
    },
    {
      "role": "child",
      "english": "I'm sleepy.",
      "ipa": "/aɪm ˈsliːpi/",
      "chinese": "我困了。"
    },
    {
      "role": "parent",
      "english": "Okay. It's time for bed.",
      "ipa": "/oʊˈkeɪ ɪts taɪm fɚ bɛd/",
      "chinese": "好，那该睡觉啦。"
    },
    {
      "role": "action",
      "text": "合上书，安顿孩子睡觉。"
    },
    {
      "role": "parent",
      "english": "Good night.",
      "ipa": "/ɡʊd naɪt/",
      "chinese": "晚安。"
    }
  ],
