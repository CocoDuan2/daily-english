  "dialogue": [
    {
      "role": "parent",
      "english": "Good morning!",
      "ipa": "/ɡʊd ˈmɔrnɪŋ/",
      "chinese": "早上好！"
    },
    {
      "role": "child",
      "english": "Good morning!",
      "ipa": "/ɡʊd ˈmɔrnɪŋ/",
      "chinese": "早上好！"
    },
    {
      "role": "parent",
      "english": "Time to wake up!",
      "ipa": "/taɪm tə weɪk ʌp/",
      "chinese": "该醒来啦！"
    },
    {
      "role": "child",
      "english": "I'm still sleepy.",
      "ipa": "/aɪm stɪl ˈsliːpi/",
      "chinese": "我还困呢。",
      "cue": "先接住困意，再替孩子示范这句，愿意才跟一次；只说“困”或揉眼睛也可以。",
      "target": true
    },
    {
      "role": "parent",
      "english": "Want to sleep more?",
      "ipa": "/wɑnt tə sliːp mɔr/",
      "chinese": "还想再睡一会儿吗？"
    },
    {
      "role": "child",
      "english": "Yes, please.",
      "ipa": "/jɛs pliːz/",
      "chinese": "想呀。",
      "cue": "点头或用中文回答也可以，不要求孩子说整句。"
    },
    {
      "role": "parent",
      "english": "Just five more minutes.",
      "ipa": "/dʒʌst faɪv mɔr ˈmɪnɪts/",
      "chinese": "那就再休息五分钟。"
    },
    {
      "role": "action",
      "text": "稍等一会儿，孩子愿意互动时再继续；仍然很困就跳过聊天，先照护。"
    },
    {
      "role": "parent",
      "english": "Did you sleep well?",
      "ipa": "/dɪd juː sliːp wɛl/",
      "chinese": "睡得好吗？"
    },
    {
      "role": "child",
      "english": "Yes. I slept well.",
      "ipa": "/jɛs aɪ slɛpt wɛl/",
      "chinese": "嗯，我睡得很好。"
    },
    {
      "role": "child",
      "english": "I'm awake.",
      "ipa": "/aɪm əˈweɪk/",
      "chinese": "我醒啦。"
    },
    {
      "role": "parent",
      "english": "Stretch your body.",
      "ipa": "/strɛtʃ jɚ ˈbɑdi/",
      "chinese": "伸个懒腰吧。"
    },
    {
      "role": "action",
      "text": "一起伸个懒腰，等孩子准备好，大人照看着稳稳下床。"
    },
    {
      "role": "parent",
      "english": "Let's go wash your face.",
      "ipa": "/lɛts ɡoʊ wɑʃ jɚ feɪs/",
      "chinese": "我们去洗脸吧。"
    }
  ],
